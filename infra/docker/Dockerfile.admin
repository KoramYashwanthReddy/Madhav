# Multi-stage Dockerfile for MAX Admin Console (Module 37)
# Stage 1: Build Admin Console Static Assets
FROM node:20-alpine AS builder

WORKDIR /app

COPY admin/package*.json ./
RUN npm ci

COPY admin/ ./
RUN npm run build

# Stage 2: Serve Production Static Assets with Nginx
FROM nginxinc/nginx-unprivileged:alpine-slim AS runner

LABEL org.opencontainers.image.title="MAX Admin Console" \
      org.opencontainers.image.description="Enterprise System Console Production Client"

COPY --from=builder /app/dist /usr/share/nginx/html
COPY infra/proxy/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 8081

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8081/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
