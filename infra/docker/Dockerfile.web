# Multi-stage Dockerfile for MAX Web Application (Module 35)
# Stage 1: Build Web App Static Assets
FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package*.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

# Stage 2: Serve Production Static Assets with Nginx
FROM nginxinc/nginx-unprivileged:alpine-slim AS runner

LABEL org.opencontainers.image.title="MAX Web Application" \
      org.opencontainers.image.description="React/TypeScript Production Web App Client"

COPY --from=builder /app/dist /usr/share/nginx/html
COPY infra/proxy/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
