# MADHAV Personal AI System — Example Configuration Environment File
# Copy this file to .env for local development ONLY.
# DO NOT commit real secrets or production credentials to version control.

# ==============================================================================
# Application Settings
# ==============================================================================
MADHAV_ENVIRONMENT=development
MADHAV_DEBUG=true

# ==============================================================================
# Server Settings
# ==============================================================================
MADHAV_SERVER_HOST=127.0.0.1
MADHAV_SERVER_PORT=8000
MADHAV_SERVER_RELOAD=true
MADHAV_SERVER_WORKERS=1

# ==============================================================================
# API Settings
# ==============================================================================
MADHAV_API_PREFIX=/api
MADHAV_API_VERSION=v1
MADHAV_API_DOCS_ENABLED=true
MADHAV_API_OPENAPI_ENABLED=true
MADHAV_API_REDOC_ENABLED=true

# ==============================================================================
# Logging Settings
# ==============================================================================
MADHAV_LOG_LEVEL=INFO
MADHAV_LOGGING__STRUCTURED_LOGGING_ENABLED=true
MADHAV_LOGGING__CONSOLE_LOGGING_ENABLED=true
MADHAV_LOGGING__INCLUDE_REQUEST_ID=true

# ==============================================================================
# Security Settings (Override in production!)
# ==============================================================================
MADHAV_SECRET_KEY=development-placeholder-secret-key-32-bytes
MADHAV_SECURITY__ALLOWED_HOSTS=["*"]
MADHAV_SECURITY__SECURE_COOKIES=false
MADHAV_SECURITY__REQUIRE_HTTPS=false

# ==============================================================================
# CORS Settings
# ==============================================================================
MADHAV_CORS__ENABLED=true
MADHAV_CORS__ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000"]
MADHAV_CORS__ALLOW_CREDENTIALS=true

# ==============================================================================
# Feature Flags
# ==============================================================================
MADHAV_FEATURES__API_DOCS=true
MADHAV_FEATURES__DEBUG_ENDPOINTS=false
MADHAV_FEATURES__EXPERIMENTAL_FEATURES=false
