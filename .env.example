# MAX Platform Environment Configuration Example
# Copy this file to .env for local development overrides.

MAX_APPLICATION__ENVIRONMENT=development
MAX_APPLICATION__DEBUG=true

MAX_SERVER__HOST=127.0.0.1
MAX_SERVER__PORT=8000
MAX_SERVER__RELOAD=true
MAX_SERVER__WORKERS=1

MAX_API__PREFIX=/api
MAX_API__VERSION=v1
MAX_API__DOCS_ENABLED=true
MAX_API__OPENAPI_ENABLED=true

MAX_LOGGING__LEVEL=INFO
MAX_LOGGING__JSON_FORMAT=true

MAX_SECURITY__SECRET_KEY=insecure-development-secret-key-change-in-production
MAX_SECURITY__ALLOWED_HOSTS=["127.0.0.1", "localhost"]

MAX_CORS__ENABLED=true
MAX_CORS__ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
MAX_CORS__ALLOW_CREDENTIALS=true

MAX_FEATURES__API_DOCS=true
MAX_FEATURES__DEBUG_ENDPOINTS=false
MAX_FEATURES__EXPERIMENTAL_FEATURES=false
