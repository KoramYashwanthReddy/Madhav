# MADHAV Platform Environment Configuration Example
# Copy this file to .env for local development overrides.

MADHAV_APPLICATION__ENVIRONMENT=development
MADHAV_APPLICATION__DEBUG=true

MADHAV_SERVER__HOST=127.0.0.1
MADHAV_SERVER__PORT=8000
MADHAV_SERVER__RELOAD=true
MADHAV_SERVER__WORKERS=1

MADHAV_API__PREFIX=/api
MADHAV_API__VERSION=v1
MADHAV_API__DOCS_ENABLED=true
MADHAV_API__OPENAPI_ENABLED=true

MADHAV_LOGGING__LEVEL=INFO
MADHAV_LOGGING__JSON_FORMAT=true

MADHAV_SECURITY__SECRET_KEY=insecure-development-secret-key-change-in-production
MADHAV_SECURITY__ALLOWED_HOSTS=["127.0.0.1", "localhost"]

MADHAV_CORS__ENABLED=true
MADHAV_CORS__ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
MADHAV_CORS__ALLOW_CREDENTIALS=true

MADHAV_FEATURES__API_DOCS=true
MADHAV_FEATURES__DEBUG_ENDPOINTS=false
MADHAV_FEATURES__EXPERIMENTAL_FEATURES=false
